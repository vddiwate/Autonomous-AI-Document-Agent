# ===================================================================
# Fluid AI - Autonomous Agent Environment Configuration
# All configurations MUST be loaded from this file or system environment.
# NO HARDCODED VALUES IN SOURCE CODE.
# ===================================================================

# Application Identity & Server Configuration
APP_NAME=Fluid AI - Autonomous Document Agent
APP_VERSION=1.0.0
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# LLM Provider Configuration (Groq Cloud)
GROQ_API_KEY=your_groq_api_key_here
MODEL_NAME=llama-3.3-70b-versatile
FALLBACK_MODEL_NAME=llama-3.1-8b-instant
LLM_TEMPERATURE=0.2
LLM_REQUEST_TIMEOUT=60.0
LLM_MAX_RETRIES=3

# Storage Configuration
DOCS_STORAGE_DIR=storage/generated_docs
